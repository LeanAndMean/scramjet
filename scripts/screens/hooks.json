{
  "size": "100x34",
  "files": {
    "build/out.txt": "built\n"
  },
  "settings": {
    "hooks": {
      "PreToolUse": [
        {"matcher": "Bash", "hooks": [{"type": "command", "command": "jq -r '.tool_input.command' | grep -q 'rm -rf' && { echo 'Blocked: rm -rf is not allowed here' >&2; exit 2; } || exit 0"}]}
      ],
      "PostToolUse": [
        {"matcher": "Write|Edit", "hooks": [{"type": "command", "command": "jq -r '.tool_response.filePath // .tool_input.file_path' >> \"$CLAUDE_PROJECT_DIR/formatted.log\"; echo '{\"systemMessage\": \"Formatted the file\"}'"}]}
      ],
      "Stop": [{"hooks": [{"type": "command", "command": "true"}]}]
    }
  },
  "replies": [
    [{"call": "bash", "arguments": {"command": "rm -rf build"}}],
    [{"call": "write", "arguments": {"path": "notes.txt", "content": "one\n"}}],
    [{"call": "bash", "arguments": {"command": "ls build; cat formatted.log"}}],
    [{"text": "The hook kept build/ and logged notes.txt."}]
  ],
  "steps": [
    {"until": "[Skills]"},
    {"sleep": 0.5},
    {"type": "clean up\r"},
    {"until": "logged notes.txt."},
    {"sleep": 0.3},
    {"shot": "after"}
  ]
}
