  "steps": [
    {
      "until": "Select next step"
    },
    {
      "type": "\r"
    },
    {
      "until": "second step is done"
    },
    {
      "sleep": 0.3
    },
    {
      "shot": "chain"
    },
    {
      "type": "/compact\r"
    },
    {
      "until": "Run the flow"
    },
    {
      "sleep": 0.3
    },
    {
      "shot": "blocks"
    },
    {
      "type": "\u000f"
    },
    {
      "sleep": 0.3
    },
    {
      "shot": "blocks-expanded"
    },
    {
      "type": "\u000f"
    },
    {
