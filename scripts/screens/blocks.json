          "next_steps": [
            {
              "message": "/flow:step two",
              "fresh_session": true,
              "reason": "Do the second."
            }
          ],
          "recommended_next_step": 0
        }
      }
    ],
    [
      {
        "call": "bash",
        "arguments": {
          "command": "yes 'a filler line, so that the context is large enough to compact' | head -n 1500"
        }
      }
    ],
    [
      {
        "call": "bash",
        "arguments": {
          "command": "yes 'a filler line, so that the context is large enough to compact' | head -n 1500"
        }
      }
    ],
    [
      {
        "text": "The second step is done."
      },
      {
        "call": "report_scramjet_command_status",
        "arguments": {
          "status": "completed",
          "summary": "Ran the second step."
        }
      }
    ],
    [
      {
        "text": "## Goal\n\nRun the flow's steps.\n\n## Progress\n\n- The first and second steps ran.\n- Nothing was changed."
      }
