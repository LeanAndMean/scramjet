{
  "size": "100x40",
  "files": {
    "README.md": "Project\n",
    ".scramjet/flow/commands/flow:step.md": "---\nnext:\n  mode: closed\n  candidates:\n    - name: flow:step\n---\nStep $1.\n"
  },
  "prompt": "/flow:step one",
  "replies": [
    [
      {"call": "bash", "arguments": {"command": "echo first step"}}
    ],
    [
      {"text": "The first step is done."},
      {"call": "report_scramjet_command_status", "arguments": {"status": "completed", "summary": "Ran the **first** step and checked its output.", "next_steps": [{"message": "/flow:step two", "fresh_session": true, "reason": "Do the second."}], "recommended_next_step": 0}}
    ],
    [
      {"text": "The second step is done."},
      {"call": "report_scramjet_command_status", "arguments": {"status": "completed", "summary": "Ran the second step."}}
    ]
  ],
  "steps": [
    {"until": "Select next step"},
    {"type": "\r"},
    {"until": "second step is done"},
    {"sleep": 0.3},
    {"shot": "chain"},
    {"type": "\u000f"},
    {"sleep": 0.3},
    {"shot": "chain-expanded"}
  ]
}
