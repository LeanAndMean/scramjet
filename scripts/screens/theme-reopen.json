{
  "size": "100x44",
  "settings": {"theme": "scramjet-dark"},
  "files": {
    "src/lib.rs": "pub fn words(text: &str) -> Vec<&str> {\n    text.split_whitespace().collect()\n}\n"
  },
  "prompt": "What does src/lib.rs do?",
  "replies": [
    [{"text": "It splits text into **words** on any run of whitespace, with `split_whitespace`."}]
  ],
  "steps": [
    {"until": "split_whitespace"},
    {"sleep": 0.3},
    {"type": "/settings\r"},
    {"until": "Thinking level"},
    {"type": "\u001b[B\u001b[B\u001b[B\u001b[B\r"},
    {"until": "New theme"},
    {"type": "\u001b[F\r"},
    {"until": "Theme editor"},
    {"type": "r"},
    {"sleep": 0.2},
    {"type": "\u001b[B\u001b[B\u001b[B\u001b[B\u001b[Bl"},
    {"sleep": 0.2},
    {"type": "r+"},
    {"sleep": 0.2},
    {"type": "\t\u001b[B\u001b[B\u001b[B\u001b[B\u001b[B"},
    {"sleep": 0.2},
    {"type": "#ff8800\r"},
    {"sleep": 0.2},
    {"type": "\t"},
    {"sleep": 0.3},
    {"shot": "made"},
    {"type": "\r"},
    {"until": "Name the theme"},
    {"type": "\r"},
    {"until": "Saved theme my-theme"},
    {"sleep": 0.3},
    {"type": "\u001b[F"},
    {"sleep": 0.3},
    {"shot": "edit-row"},
    {"type": "\r"},
    {"until": "Theme editor"},
    {"sleep": 0.3},
    {"shot": "reopened"},
    {"type": "\t"},
    {"sleep": 0.3},
    {"shot": "reopened-roles"},
    {"type": "\t-"},
    {"sleep": 0.3},
    {"type": "\r"},
    {"until": "replaces it"},
    {"sleep": 0.3},
    {"shot": "name"},
    {"type": "\r"},
    {"until": "Replaced theme my-theme"},
    {"sleep": 0.3},
    {"shot": "replaced"},
    {"type": "\u001b"},
    {"sleep": 0.3},
    {"type": "\u001b"},
    {"sleep": 0.3},
    {"type": "!ls \"$SCRAMJET_CODING_AGENT_DIR/themes\"; grep -A9 themeEditor \"$SCRAMJET_CODING_AGENT_DIR/themes/my-theme.json\"\r"},
    {"until": "contrast"},
    {"sleep": 0.5},
    {"shot": "file"}
