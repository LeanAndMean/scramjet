{
  "size": "100x30",
  "settings": {
    "hooks": {
      "PreToolUse": [
        {"matcher": "Bash", "hooks": [{"type": "command", "command": "jq -r '.tool_input.command' | grep -q 'rm -rf' && exit 2 || exit 0"}]},
        {"matcher": "Write|Edit", "hooks": [{"type": "command", "command": "./scripts/check-path.sh", "timeout": 5}, {"type": "prompt", "prompt": "Is this safe?"}]}
      ],
      "PostToolUse": [
        {"matcher": "Write|Edit", "hooks": [{"type": "command", "command": "cargo fmt"}]}
      ],
      "Stop": [{"hooks": [{"type": "command", "command": "notify-send 'Done'"}]}],
      "SessionEnd": [{"hooks": [{"type": "command", "command": "echo bye >> ~/sessions.log"}]}]
    }
  },
  "env": {"EDITOR": "true", "VISUAL": "true"},
  "replies": [],
  "steps": [
    {"until": "[Skills]"},
    {"sleep": 0.5},
    {"type": "/hooks\r"},
    {"until": "SessionEnd"},
    {"sleep": 0.3},
    {"shot": "list"},
    {"type": "\u001b[B\u001b[B"},
    {"sleep": 0.3},
    {"shot": "moved"},
    {"type": "\r"},
    {"sleep": 0.8},
    {"shot": "after-enter"},
    {"type": "\u001b"},
    {"sleep": 0.5},
    {"shot": "closed"}
  ]
}
