{
  "size": "100x44",
  "settings": {"theme": "scramjet-dark", "look": "panels"},
  "files": {
    "src/lib.rs": "pub fn words(text: &str) -> Vec<&str> {\n    text.split_whitespace().collect()\n}\n"
  },
  "prompt": "What does src/lib.rs do?",
  "replies": [
    [{"text": "It splits text into **words** on any run of whitespace, with `split_whitespace`."}]
  ],
  "steps": [
    {"until": "split_whitespace"},
    {"sleep": 0.3},
    {"type": "/settings\r"},
    {"until": "Thinking level"},
    {"type": "\u001b[B\u001b[B\u001b[B\u001b[B\r"},
    {"until": "New theme"},
    {"type": "\u001b[F"},
    {"sleep": 0.3},
    {"shot": "from-row"},
    {"type": "\r"},
    {"until": "Theme editor"},
    {"sleep": 0.3},
    {"shot": "from"},
    {"type": "\u001b[B\u001b[B\u001b[B\u001b[B\u001b[Bl"},
    {"sleep": 0.2},
    {"type": "r"},
    {"sleep": 0.3},
    {"shot": "from-rolled"},
    {"type": "\t"},
    {"sleep": 0.3},
    {"shot": "from-roles"},
    {"type": "\t"},
    {"sleep": 0.2},
    {"type": "u"},
    {"sleep": 0.3},
    {"shot": "from-undone"},
    {"type": "\r"},
    {"until": "Name the theme"},
    {"type": "\r"},
    {"until": "Saved theme my-theme"},
    {"sleep": 0.3},
    {"type": "\u001b[F"},
    {"sleep": 0.3},
    {"shot": "edit-row"},
    {"type": "\u001b"},
    {"sleep": 0.3},
    {"type": "\u001b"},
    {"sleep": 0.3},
    {"type": "!grep -A3 -E '\"(from|muted)\"' \"$SCRAMJET_CODING_AGENT_DIR/themes/my-theme.json\" | tail -12\r"},
    {"until": "from"},
    {"sleep": 0.5},
    {"shot": "file"}
  ]
}
