{
  "size": "100x40",
  "settings": {"theme": "scramjet-dark"},
  "steps": [
    {"until": "scramjet-rs"},
    {"type": "/release"},
    {"until": "View release notes"},
    {"shot": "completion"},
    {"type": "\r"},
    {"until": "d titles"},
    {"sleep": 0.3},
    {"shot": "release-notes"},
    {"type": "\u001b[6~"},
    {"sleep": 0.3},
    {"shot": "release-notes-scrolled"},
    {"type": "d"},
    {"until": "d details"},
    {"sleep": 0.3},
    {"shot": "release-notes-titles"},
    {"type": "\u001b"},
    {"sleep": 0.5},
    {"shot": "release-notes-closed"}
  ]
}
