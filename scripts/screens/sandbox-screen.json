{
  "size": "100x40",
  "settings": {
    "sandbox": {"filesystem": {"denyRead": ["~/notes"]}}
  },
  "files": {
    "README.md": "Project\n"
  },
  "steps": [
    {"sleep": 1},
    {"type": "/sandbox\r"},
    {"until": "Subagents"},
    {"sleep": 0.3},
    {"shot": "defaults"},
    {"type": "\r"},
    {"until": "Can change  \u2191\u2193"},
    {"sleep": 0.3},
    {"shot": "change"},
    {"type": "\u001b[A\r"},
    {"until": "Sandbox: workspace-write"},
    {"sleep": 0.3},
    {"shot": "on"},
    {"type": "\u001b[B\r"},
    {"until": "Can read  \u2191\u2193"},
    {"type": "\u001b[B\r"},
    {"until": "Can read: this project"},
    {"type": "\u001b[B\u001b[B\u001b[B\u001b[B\r"},
    {"until": "Path to hide"},
    {"type": "~/drafts\r"},
    {"until": "is hidden"},
    {"sleep": 0.3},
    {"shot": "hidden"},
    {"type": "\u0013"},
    {"until": "Saved as the default"},
    {"sleep": 0.3},
    {"shot": "saved"},
    {"type": "\u001b[F\r"},
    {"until": "Subagents' sandbox"},
    {"sleep": 0.3},
    {"shot": "subagents"},
    {"type": "\u001b[B\u001b[B\u001b[B\u001b[B\r"},
    {"until": "own"},
    {"sleep": 0.3},
    {"shot": "subagents-own"},
    {"type": "\u001b"},
    {"sleep": 0.3},
    {"type": "\u001b"},
    {"sleep": 0.5},
    {"type": "!cat \"$XDG_CONFIG_HOME/scramjet/settings.json\"\r"},
    {"until": "denyRead"},
    {"sleep": 0.3},
    {"shot": "file"},
    {"type": "/permissions\r"},
    {"until": "Subagents"},
    {"size": "60x40"},
    {"sleep": 0.5},
    {"shot": "narrow"},
    {"type": "\u001b"},
    {"size": "100x40"},
    {"sleep": 0.3},
    {"type": "/settings\r"},
    {"until": "Settings"},
    {"type": "sandbox"},
    {"until": "> sandbox"},
    {"sleep": 0.3},
    {"shot": "settings"},
    {"type": "\r"},
    {"until": "Subagents"},
    {"sleep": 0.3},
    {"shot": "from-settings"},
    {"type": "\u001b\u001b"},
    {"sleep": 0.3},
    {"type": "\u0004"}
  ]
}
