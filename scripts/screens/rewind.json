{
  "size": "100x40",
  "files": {
    "notes.txt": "one\n"
  },
  "replies": [
    [
      {
        "call": "edit",
        "arguments": {
          "path": "notes.txt",
          "edits": [
            {
              "oldText": "one\n",
              "newText": "one\ntwo\n"
            }
          ]
        }
      },
      {
        "call": "write",
        "arguments": {
          "path": "drafts/new.txt",
          "content": "new\n"
        }
      }
    ],
    [
      {
        "text": "notes.txt holds one and two, and drafts/new.txt is made."
      }
    ]
  ],
  "steps": [
    {
      "until": "[Skills]"
    },
    {
      "sleep": 0.5
    },
    {
      "type": "add two to notes.txt and make a draft\r"
    },
    {
      "until": "drafts/new.txt is made"
    },
    {
      "sleep": 0.5
    },
    {
      "type": "/rewind\r"
    },
    {
      "until": "Rewind to before"
    },
    {
      "sleep": 0.3
    },
    {
      "shot": "list"
    },
    {
      "type": "\r"
    },
    {
      "until": "Restore code and conversation"
    },
    {
      "sleep": 0.3
    },
    {
      "shot": "choices"
    },
    {
      "type": "\r"
    },
    {
      "until": "Removed"
    },
    {
      "sleep": 0.5
    },
    {
      "shot": "rewound"
    },
    {
      "type": "\u0003"
    },
    {
      "sleep": 0.3
    },
    {
      "type": "!cat notes.txt; ls drafts/new.txt\r"
    },
    {
      "until": "No such file"
    },
    {
      "sleep": 0.5
    },
    {
      "shot": "after"
    }
  ]
}
