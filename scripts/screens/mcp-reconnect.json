{
  "size": "100x40",
  "settings": {
    "theme": "scramjet-dark",
    "mcpServers": {
      "time": {"command": "uvx", "args": ["mcp-server-time", "--local-timezone", "UTC"]},
      "clock": {"command": "sh", "args": ["-c", "test -f ready || { echo 'no ready file' >&2; exit 1; }; exec uvx mcp-server-time --local-timezone UTC"]}
    }
  },
  "files": {
    "README.md": "# Clock\n"
  },
  "prompt": "What time is it?",
  "replies": [
    [{"text": "Let me know when the clock is ready."}],
    [{"call": "mcp_call", "arguments": {"server": "clock", "tool": "get_current_time", "arguments": {"timezone": "Asia/Tokyo"}}}],
    [{"text": "The clock answered."}]
  ],
  "steps": [
    {"until": "Let me know when the clock is ready."},
    {"type": "/mcp reconnect clock\r"},
    {"until": "could not reconnect"},
    {"type": "!!touch ready\r"},
    {"sleep": 1},
    {"type": "/mcp reconnect\r"},
    {"until": "Reconnected to clock"},
    {"sleep": 0.5},
    {"shot": "reconnected"},
    {"type": "Try the clock\r"},
    {"until": "The clock answered."},
    {"shot": "called"}
  ]
}
