{
  "providers": {
    "screens": {
      "baseUrl": "http://127.0.0.1:PORT/v1",
      "api": "openai-responses",
      "apiKey": "sk-from-the-entry",
      "headers": {"X-Fixture": "compatibility"},
      "models": [
        {
          "id": "fixture-model",
          "name": "Fixture Model",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 200000,
          "maxTokens": 32000,
          "cost": {"input": 1.25, "output": 10, "cacheRead": 0.125, "cacheWrite": 0}
        }
      ]
    }
  }
}
