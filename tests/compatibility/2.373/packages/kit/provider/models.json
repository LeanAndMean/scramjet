{
  "engines": {"scramjet": ">=2.335.0"},
  "credentialFiles": ["~/.fixture-store"],
  "logins": {
    "fixture-login": {"name": "Fixture Login", "command": ["./login"]}
  },
  "providers": {
    "packaged": {
      "baseUrl": "http://127.0.0.1:PORT/v1",
      "api": "openai-completions",
      "apiKey": "sk-from-the-package",
      "compat": {"supportsDeveloperRole": false},
      "models": [
        {
          "id": "packaged-model",
          "name": "Packaged Model",
          "reasoning": false,
          "input": ["text"],
          "contextWindow": 128000,
          "maxTokens": 16000,
          "cost": {"input": 0.5, "output": 2, "cacheRead": 0.05, "cacheWrite": 0}
        }
      ]
    }
  }
}
