{
  "lastChangelogVersion": "2.335.6",
  "defaultProvider": "screens",
  "defaultModel": "fixture-model",
  "effortLevel": "medium",
  "startupModel": "per-directory",
  "enabledModels": [
    "screens/*"
  ],
  "theme": "fixture",
  "look": "panels",
  "bottom": "boxed",
  "banner": "logo",
  "collapseChangelog": true,
  "hideThinkingBlock": true,
  "copyOnSelect": false,
  "spellCheck": true,
  "retainTranscriptOnExit": true,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "resumeChains": "threaded",
  "steeringMode": "one-at-a-time",
  "followUpMode": "all",
  "markdown": {
    "toolDisplay": "rendered"
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "branchSummary": {
    "reserveTokens": 16384,
    "skipPrompt": false
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetryDelayMs": 60000
    }
  },
  "hideCredentials": "unattended",
  "tools": {
    "find": true,
    "grep": true
  },
  "commandSets": [],
  "packages": [
    "../../packages/kit"
  ],
  "skills": [],
  "mcpServers": {
    "fixture": {
      "command": "fixture-mcp-server",
      "args": [
        "--stdio"
      ]
    }
  },
  "disabledMcpServers": [
    "fixture"
  ],
  "sandbox": {
    "network": false,
    "filesystem": {
      "denyRead": [
        "~/.aws"
      ],
      "allowWrite": [
        "~/.cache/uv"
      ]
    }
  },
  "terminal": {
    "showTerminalProgress": true
  }
}
